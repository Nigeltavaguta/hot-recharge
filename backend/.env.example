HOT_CLIENT_MODE=stub
HOT_TRANSACTIONS_ENABLED=false
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hotrecharge
SPRING_DATASOURCE_USERNAME=hotrecharge
SPRING_DATASOURCE_PASSWORD=replace-locally
